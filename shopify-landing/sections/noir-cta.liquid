{% render 'noir-assets' %}
<section class="noir noir-section noir-cta">
  <div class="noir-wrap" data-reveal>
    {%- if section.settings.eyebrow != blank -%}<p class="noir-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="noir-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="noir-lead">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="noir-btn noir-btn--solid" href="{{ section.settings.button_link | default: '#buy' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Noir closing CTA",
  "tag": "div",
  "class": "noir-section-cta",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "This festive season" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Light it <em>differently.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Limited batch of 2,000 boxes. When they’re gone, they’re gone until next year.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get the Noir Puja Box" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the product section (#buy)." }
  ],
  "presets": [{ "name": "Noir closing CTA" }]
}
{% endschema %}
